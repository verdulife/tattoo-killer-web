---
import { routes } from "@/lib/routes";
import Close from "@/assets/icons/Close.astro";
import Menu from "@/assets/icons/Menu.astro";

const links = [...routes, { slug: "#contact", title: "Contacto" }];
---

<header
  id="siteHeader"
  class="fixed inset-x-0 top-0 z-50 flex justify-center p-3 md:p-4"
>
  <nav
    class="flex w-full max-w-6xl items-center justify-between rounded-xl border border-neutral-200 bg-neutral-50/70 p-2 backdrop-blur md:p-3 lg:px-8"
  >
    <a href="/" aria-label="TattooKiller — ir al inicio">
      <img src="/logo-h-b.svg" alt="TattooKiller" class="h-9 md:h-12" />
    </a>

    <ul class="hidden items-center lg:flex">
      {
        links.map(({ slug, title }) => (
          <li class="flex">
            <a
              href={slug}
              class="rounded-lg border-2 border-transparent px-6 pb-2 pt-3 font-title text-base transition-all hover:bg-neutral-800 hover:text-neutral-100"
            >
              {title}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="menuBtn"
      type="button"
      class="flex size-11 items-center justify-center rounded-lg text-neutral-800 transition-colors active:bg-neutral-200 lg:hidden"
      aria-controls="mobileMenu"
      aria-expanded="false"
      aria-label="Abrir menú"
    >
      <Menu class="size-7" />
    </button>
  </nav>
</header>

<div
  id="mobileMenu"
  class="fixed inset-0 z-[60] flex hidden flex-col overflow-y-auto bg-neutral-800 lg:hidden"
>
  <div class="flex items-center justify-between p-5">
    <a href="/" aria-label="TattooKiller — ir al inicio">
      <img src="/logo-h-w.svg" alt="TattooKiller" class="h-9" />
    </a>

    <button
      id="menuClose"
      type="button"
      class="flex size-11 items-center justify-center rounded-lg text-neutral-100 transition-colors hover:bg-neutral-700"
      aria-label="Cerrar menú"
    >
      <Close class="size-7" />
    </button>
  </div>

  <nav class="flex flex-1 flex-col items-center px-6 pt-24">
    <ul class="flex flex-col items-center gap-3 md:gap-5">
      {
        links.map(({ slug, title }) => (
          <li>
            <a
              href={slug}
              class="block px-6 py-2 font-title text-3xl text-neutral-100 transition-colors hover:text-neutral-400 md:text-4xl"
            >
              {title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  const header = document.querySelector<HTMLElement>("#siteHeader");
  const menuBtn = document.querySelector<HTMLButtonElement>("#menuBtn");
  const menu = document.querySelector<HTMLElement>("#mobileMenu");
  const menuClose = document.querySelector<HTMLButtonElement>("#menuClose");

  const openMenu = () => {
    menu?.classList.remove("hidden");
    menu?.classList.add("is-open");
    menuBtn?.setAttribute("aria-expanded", "true");
    document.body.classList.add("overflow-hidden");
    header?.setAttribute("inert", "");
    menuClose?.focus();
  };

  const closeMenu = ({ restoreFocus = false } = {}) => {
    if (!menu || menu.classList.contains("hidden")) return;
    menu.classList.add("hidden");
    menu.classList.remove("is-open");
    menuBtn?.setAttribute("aria-expanded", "false");
    document.body.classList.remove("overflow-hidden");
    header?.removeAttribute("inert");
    if (restoreFocus) menuBtn?.focus();
  };

  menuBtn?.addEventListener("click", openMenu);
  menuClose?.addEventListener("click", () => closeMenu({ restoreFocus: true }));

  // Choosing any link closes the overlay. In-page anchors (#contact) do not
  // reload the page, so they would otherwise leave the overlay open.
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => closeMenu());
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu({ restoreFocus: true });
  });

  // The overlay only exists below the lg breakpoint.
  window
    .matchMedia("(min-width: 1024px)")
    .addEventListener("change", (event) => {
      if (event.matches) closeMenu();
    });
</script>

<style>
  #mobileMenu.is-open {
    animation: menu-fade 200ms ease-out;
  }

  @keyframes menu-fade {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
